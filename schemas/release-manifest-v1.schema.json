{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/reneboellund/Ai.WAGVID/schemas/release-manifest-v1.schema.json",
  "title": "Ai.WAGVID release and upgrade compatibility manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "git_sha", "supported_postgresql", "migration_heads", "schemas", "upgrade_from", "rollback", "android"],
  "properties": {
    "schema": {"const": "ai.wagvid.release-manifest.v1"},
    "version": {"type": "string", "minLength": 1},
    "git_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "image_digest": {"type": ["string", "null"]},
    "built_at": {"type": ["string", "null"], "format": "date-time"},
    "supported_postgresql": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "migration_heads": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config", "storage", "rules", "models"],
      "properties": {
        "config": {"type": "string", "minLength": 1},
        "storage": {"type": "string", "minLength": 1},
        "rules": {"type": "string", "minLength": 1},
        "models": {"type": "string", "minLength": 1}
      }
    },
    "upgrade_from": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direct"],
      "properties": {
        "direct": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "requires_intermediate": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
      }
    },
    "breaking_changes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code_only_supported", "database_restore_required_after_migration"],
      "properties": {
        "code_only_supported": {"type": "boolean"},
        "database_restore_required_after_migration": {"type": "boolean"},
        "notes": {"type": ["string", "null"]}
      }
    },
    "android": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_protocol", "max_protocol"],
      "properties": {
        "min_protocol": {"type": "integer", "minimum": 1},
        "max_protocol": {"type": "integer", "minimum": 1},
        "min_app_version": {"type": ["string", "null"]}
      }
    },
    "required_preflight": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
