{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/reneboellund/Ai.WAGVID/schemas/competition-analysis-task-v1.schema.json",
  "title": "Ai.WAGVID identity-minimized competition analysis task v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "task_id", "idempotency_key", "apparatus", "rule_profile", "media",
    "analysis_profile_digest", "requested_at"
  ],
  "properties": {
    "schema": {"const": "ai.wagvid.competition-analysis-task.v1"},
    "task_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"$ref": "#/$defs/sha256"},
    "apparatus": {"enum": ["VT", "UB", "BB", "FX"]},
    "rule_profile": {"type": ["string", "null"]},
    "media": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/media"}
    },
    "analysis_profile_digest": {"$ref": "#/$defs/sha256"},
    "requested_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_id", "sha256", "download_uri", "content_type", "camera_id", "view"],
      "properties": {
        "media_id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "download_uri": {"type": "string", "minLength": 1},
        "content_type": {"type": "string", "pattern": "^video/"},
        "camera_id": {"type": ["string", "null"]},
        "view": {"type": ["string", "null"]}
      }
    }
  }
}
