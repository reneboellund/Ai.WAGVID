{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/reneboellund/Ai.WAGVID/schemas/production-decision-provenance-v1.schema.json",
  "title": "Ai.WAGVID production decision provenance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "decision_id", "organization_id", "object_ref", "semantic_layer", "state",
    "material", "authority_ref", "evidence", "rulepack_digest", "model_bundle_digest",
    "software_digest", "config_digest", "calibration_digest", "created_at", "limitations",
    "supersedes_decision_id", "decision_digest"
  ],
  "properties": {
    "schema": {"const": "ai.wagvid.production-decision-provenance.v1"},
    "decision_id": {"type": "string", "minLength": 1},
    "organization_id": {"type": "string", "minLength": 1},
    "object_ref": {"type": "string", "minLength": 1},
    "semantic_layer": {
      "enum": [
        "observed-fact", "judging-interpretation", "score-effect", "pattern",
        "coaching-hypothesis", "suggested-training-focus"
      ]
    },
    "state": {"enum": ["provisional", "confirmed", "rejected", "unresolved"]},
    "material": {"type": "boolean"},
    "authority_ref": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "rulepack_digest": {"$ref": "#/$defs/sha256"},
    "model_bundle_digest": {"$ref": "#/$defs/sha256"},
    "software_digest": {"$ref": "#/$defs/sha256"},
    "config_digest": {"$ref": "#/$defs/sha256"},
    "calibration_digest": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "created_at": {"type": "string", "format": "date-time"},
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "supersedes_decision_id": {"type": ["string", "null"]},
    "decision_digest": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"material": {"const": true}, "state": {"const": "confirmed"}},
        "required": ["material", "state"]
      },
      "then": {
        "properties": {
          "evidence": {
            "contains": {
              "type": "object",
              "properties": {
                "kind": {"const": "source-interval"},
                "represented_as_original": {"const": true}
              },
              "required": ["kind", "represented_as_original"]
            },
            "minContains": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id", "evidence_digest", "canonical_source_sha256", "kind",
        "represented_as_original", "evidence_provenance_digest"
      ],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "evidence_digest": {"$ref": "#/$defs/sha256"},
        "canonical_source_sha256": {"$ref": "#/$defs/sha256"},
        "kind": {
          "enum": [
            "source-interval", "proxy", "overlay", "interpolated", "generated-visualization"
          ]
        },
        "represented_as_original": {"type": "boolean"},
        "evidence_provenance_digest": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {"properties": {"represented_as_original": {"const": true}}, "required": ["represented_as_original"]},
          "then": {"properties": {"kind": {"const": "source-interval"}}}
        },
        {
          "if": {"properties": {"kind": {"const": "source-interval"}}, "required": ["kind"]},
          "then": {"properties": {"represented_as_original": {"const": true}}}
        }
      ]
    }
  }
}
