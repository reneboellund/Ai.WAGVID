{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/reneboellund/Ai.WAGVID/schemas/dataset-rights-v1.schema.json",
  "title": "Ai.WAGVID dataset rights v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "record_id", "source_reference", "source_digest", "rights_reference",
    "rights_digest", "permissions", "retention_class", "valid_from", "valid_until",
    "lifecycle", "revoked_at", "record_digest"
  ],
  "properties": {
    "schema": {"const": "ai.wagvid.dataset-rights.v1"},
    "record_id": {"type": "string", "minLength": 1},
    "source_reference": {"type": "string", "minLength": 1},
    "source_digest": {"$ref": "#/$defs/sha256"},
    "rights_reference": {"type": "string", "minLength": 1},
    "rights_digest": {"$ref": "#/$defs/sha256"},
    "permissions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["view", "download", "analyze", "retain", "train", "export", "share-evidence"]
      }
    },
    "retention_class": {"type": "string", "minLength": 1},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": ["string", "null"], "format": "date-time"},
    "lifecycle": {"enum": ["active", "revoked"]},
    "revoked_at": {"type": ["string", "null"], "format": "date-time"},
    "record_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
