{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/reneboellund/Ai.WAGVID/schemas/temporal-recognition-v1.schema.json",
  "title": "Ai.WAGVID temporal recognition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "bundle_id", "routine_id", "apparatus", "model_bundle_digest",
    "perception_bundle_digest", "created_at", "limitations", "bundle_digest", "candidates"
  ],
  "properties": {
    "schema": {"const": "ai.wagvid.temporal-recognition.v1"},
    "bundle_id": {"type": "string", "minLength": 1},
    "routine_id": {"type": "string", "minLength": 1},
    "apparatus": {"enum": ["VT", "UB", "BB", "FX"]},
    "model_bundle_digest": {"$ref": "#/$defs/sha256"},
    "perception_bundle_digest": {"$ref": "#/$defs/sha256"},
    "created_at": {"type": "string", "format": "date-time"},
    "limitations": {"$ref": "#/$defs/limitations"},
    "bundle_digest": {"$ref": "#/$defs/sha256"},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/candidate"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "media_sha256", "camera_id", "start_ms", "end_ms", "evidence_digest", "view_digest"
      ],
      "properties": {
        "media_sha256": {"$ref": "#/$defs/sha256"},
        "camera_id": {"type": "string", "minLength": 1},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 1},
        "evidence_digest": {"$ref": "#/$defs/sha256"},
        "view_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id", "evidence_digest", "attribute", "value", "confidence_milli",
        "observation_digest"
      ],
      "properties": {
        "observation_id": {"type": "string", "minLength": 1},
        "evidence_digest": {"$ref": "#/$defs/sha256"},
        "attribute": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1},
        "confidence_milli": {"type": "integer", "minimum": 0, "maximum": 1000},
        "observation_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "element_id", "family", "probability_milli", "distinguishing_observation_ids"
      ],
      "properties": {
        "element_id": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1},
        "probability_milli": {"type": "integer", "minimum": 1, "maximum": 1000},
        "distinguishing_observation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "probability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alternatives", "unknown_ood_milli", "other_known_milli"],
      "properties": {
        "alternatives": {
          "type": "array",
          "items": {"$ref": "#/$defs/alternative"}
        },
        "unknown_ood_milli": {"type": "integer", "minimum": 0, "maximum": 1000},
        "other_known_milli": {"type": "integer", "minimum": 0, "maximum": 1000}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id", "start_ms", "end_ms", "views", "observations", "probability",
        "model_bundle_digest", "model_config_digest", "perception_bundle_digest",
        "sequence_context_digest", "created_at", "limitations", "candidate_digest"
      ],
      "properties": {
        "segment_id": {"type": "string", "minLength": 1},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 1},
        "views": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/view"}},
        "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
        "probability": {"$ref": "#/$defs/probability"},
        "model_bundle_digest": {"$ref": "#/$defs/sha256"},
        "model_config_digest": {"$ref": "#/$defs/sha256"},
        "perception_bundle_digest": {"$ref": "#/$defs/sha256"},
        "sequence_context_digest": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "created_at": {"type": "string", "format": "date-time"},
        "limitations": {"$ref": "#/$defs/limitations"},
        "candidate_digest": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
