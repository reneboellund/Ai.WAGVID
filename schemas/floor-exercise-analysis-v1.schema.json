{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/reneboellund/Ai.WAGVID/schemas/floor-exercise-analysis-v1.schema.json",
  "title":"Ai.WAGVID floor-exercise analysis v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","analysis_id","routine_id","apparatus","source_media_sha256","timing","geometry","model_bundle_digest","perception_bundle_digest","created_at","limitations","bundle_digest","intervals","observations","connections"],
  "properties":{
    "schema":{"const":"ai.wagvid.floor-exercise-analysis.v1"},
    "analysis_id":{"type":"string","minLength":1},
    "routine_id":{"type":"string","minLength":1},
    "apparatus":{"const":"FX"},
    "source_media_sha256":{"$ref":"#/$defs/sha"},
    "timing":{"$ref":"#/$defs/timing"},
    "geometry":{"$ref":"#/$defs/geometry"},
    "model_bundle_digest":{"$ref":"#/$defs/sha"},
    "perception_bundle_digest":{"$ref":"#/$defs/sha"},
    "created_at":{"type":"string","format":"date-time"},
    "limitations":{"$ref":"#/$defs/strings"},
    "bundle_digest":{"$ref":"#/$defs/sha"},
    "intervals":{"type":"array","items":{"$ref":"#/$defs/interval"}},
    "observations":{"type":"array","items":{"$ref":"#/$defs/observation"}},
    "connections":{"type":"array","items":{"$ref":"#/$defs/connection"}}
  },
  "$defs":{
    "sha":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "strings":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "timing":{"type":"object","additionalProperties":false,"required":["start_ms","end_ms","duration_ms","source","timeline_digest","confidence_milli","evidence_digests","limitations","timing_digest"],"properties":{"start_ms":{"type":"integer","minimum":0},"end_ms":{"type":"integer","minimum":1},"duration_ms":{"type":"integer","minimum":1},"source":{"enum":["media-timeline","audio-timeline","combined"]},"timeline_digest":{"$ref":"#/$defs/sha"},"confidence_milli":{"type":"integer","minimum":0,"maximum":1000},"evidence_digests":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/sha"}},"limitations":{"$ref":"#/$defs/strings"},"timing_digest":{"$ref":"#/$defs/sha"}}},
    "geometry":{"type":"object","additionalProperties":false,"required":["state","floor_polygon_digest","reason"],"properties":{"state":{"enum":["available","unavailable"]},"floor_polygon_digest":{"anyOf":[{"$ref":"#/$defs/sha"},{"type":"null"}]},"reason":{"type":"string","minLength":1}},"allOf":[{"if":{"properties":{"state":{"const":"available"}}},"then":{"properties":{"floor_polygon_digest":{"$ref":"#/$defs/sha"}}}}]},
    "interval":{"type":"object","additionalProperties":false,"required":["interval_id","kind","start_ms","end_ms","confidence_milli","temporal_candidate_digest","family","element_id","accepted","limitations","evidence_digests","interval_digest"],"properties":{"interval_id":{"type":"string","minLength":1},"kind":{"enum":["routine","tumbling-pass","acro-candidate","dance-candidate","turn-candidate","corner-or-preparation","choreography","landing"]},"start_ms":{"type":"integer","minimum":0},"end_ms":{"type":"integer","minimum":1},"confidence_milli":{"type":"integer","minimum":0,"maximum":1000},"temporal_candidate_digest":{"anyOf":[{"$ref":"#/$defs/sha"},{"type":"null"}]},"family":{"type":["string","null"]},"element_id":{"type":["string","null"]},"accepted":{"type":"boolean"},"limitations":{"$ref":"#/$defs/strings"},"evidence_digests":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/sha"}},"interval_digest":{"$ref":"#/$defs/sha"}}},
    "observation":{"type":"object","additionalProperties":false,"required":["observation_id","kind","start_ms","end_ms","value","confidence_milli","floor_polygon_digest","criterion_id","limitations","evidence_digests","observation_digest"],"properties":{"observation_id":{"type":"string","minLength":1},"kind":{"enum":["rotation","twist","body-shape","landing-displacement","step-or-fall","boundary-candidate","connection-timing","artistry-criterion-evidence"]},"start_ms":{"type":"integer","minimum":0},"end_ms":{"type":"integer","minimum":1},"value":{"type":"string","minLength":1},"confidence_milli":{"type":"integer","minimum":0,"maximum":1000},"floor_polygon_digest":{"anyOf":[{"$ref":"#/$defs/sha"},{"type":"null"}]},"criterion_id":{"type":["string","null"]},"limitations":{"$ref":"#/$defs/strings"},"evidence_digests":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/sha"}},"observation_digest":{"$ref":"#/$defs/sha"}}},
    "connection":{"type":"object","additionalProperties":false,"required":["connection_id","first_interval_id","second_interval_id","gap_ms","evidence_observation_ids","state","confidence_milli"],"properties":{"connection_id":{"type":"string","minLength":1},"first_interval_id":{"type":"string","minLength":1},"second_interval_id":{"type":"string","minLength":1},"gap_ms":{"type":"integer","minimum":0},"evidence_observation_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"state":{"enum":["continuous","interrupted","unresolved"]},"confidence_milli":{"type":"integer","minimum":0,"maximum":1000}}}
  }
}
