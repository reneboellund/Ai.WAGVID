{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/reneboellund/Ai.WAGVID/schemas/compute-worker-v1.schema.json",
  "title": "Ai.WAGVID compute worker capability v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "worker_id", "provider", "location", "healthy", "devices", "model_bundles"],
  "properties": {
    "schema": {"const": "ai.wagvid.compute-worker.v1"},
    "worker_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "location": {"type": "string", "minLength": 1},
    "healthy": {"type": "boolean"},
    "ephemeral": {"type": "boolean", "default": false},
    "queue_depth": {"type": "integer", "minimum": 0},
    "active_jobs": {"type": "integer", "minimum": 0},
    "hourly_cost": {"type": ["number", "null"], "minimum": 0},
    "storage_locality": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "model_bundles": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "devices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["device_id", "backend", "vendor", "model", "precisions", "capabilities"],
        "properties": {
          "device_id": {"type": "string", "minLength": 1},
          "backend": {"enum": ["cpu", "cuda", "rocm", "openvino-gpu", "cloud"]},
          "vendor": {"type": "string", "minLength": 1},
          "model": {"type": "string", "minLength": 1},
          "architecture": {"type": ["string", "null"]},
          "device_index": {"type": ["integer", "null"], "minimum": 0},
          "total_vram_mb": {"type": ["integer", "null"], "minimum": 0},
          "free_vram_mb": {"type": ["integer", "null"], "minimum": 0},
          "driver_version": {"type": ["string", "null"]},
          "runtime_version": {"type": ["string", "null"]},
          "precisions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["fp32", "fp16", "bf16", "int8"]}},
          "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
