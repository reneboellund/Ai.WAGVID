{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/reneboellund/Ai.WAGVID/schemas/balance-beam-analysis-v1.schema.json",
  "title": "Ai.WAGVID balance-beam analysis v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "analysis_id", "routine_id", "apparatus", "source_media_sha256", "geometry", "model_bundle_digest", "perception_bundle_digest", "created_at", "limitations", "bundle_digest", "observations", "elements", "series", "artistry_decisions"],
  "properties": {
    "schema": {"const": "ai.wagvid.balance-beam-analysis.v1"},
    "analysis_id": {"type": "string", "minLength": 1},
    "routine_id": {"type": "string", "minLength": 1},
    "apparatus": {"const": "BB"},
    "source_media_sha256": {"$ref": "#/$defs/sha"},
    "geometry": {"$ref": "#/$defs/geometry"},
    "model_bundle_digest": {"$ref": "#/$defs/sha"},
    "perception_bundle_digest": {"$ref": "#/$defs/sha"},
    "created_at": {"type": "string", "format": "date-time"},
    "limitations": {"$ref": "#/$defs/strings"},
    "bundle_digest": {"$ref": "#/$defs/sha"},
    "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
    "elements": {"type": "array", "items": {"$ref": "#/$defs/element"}},
    "series": {"type": "array", "items": {"$ref": "#/$defs/series"}},
    "artistry_decisions": {"type": "array", "items": {"$ref": "#/$defs/artistryDecision"}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "geometry": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "geometry_digest", "reason"],
      "properties": {
        "state": {"enum": ["available", "unavailable"]},
        "geometry_digest": {"anyOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [{"if": {"properties": {"state": {"const": "available"}}}, "then": {"properties": {"geometry_digest": {"$ref": "#/$defs/sha"}}}}]
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["observation_id", "kind", "start_ms", "end_ms", "value", "confidence_milli", "geometry_digest", "criterion_id", "limitations", "evidence_digests", "observation_digest"],
      "properties": {
        "observation_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["alignment", "balance-correction", "pause-or-hesitation", "foot-hand-relation", "fall-or-off-beam", "remount", "mount", "dismount", "artistry-criterion-evidence"]},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 1},
        "value": {"type": "string", "minLength": 1},
        "confidence_milli": {"type": "integer", "minimum": 0, "maximum": 1000},
        "geometry_digest": {"anyOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
        "criterion_id": {"type": ["string", "null"]},
        "limitations": {"$ref": "#/$defs/strings"},
        "evidence_digests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha"}},
        "observation_digest": {"$ref": "#/$defs/sha"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "artistry-criterion-evidence"}}}, "then": {"properties": {"criterion_id": {"type": "string", "minLength": 1}}}}
      ]
    },
    "element": {
      "type": "object", "additionalProperties": false,
      "required": ["segment_id", "temporal_candidate_digest", "start_ms", "end_ms", "family", "element_id", "accepted"],
      "properties": {
        "segment_id": {"type": "string", "minLength": 1},
        "temporal_candidate_digest": {"$ref": "#/$defs/sha"},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 1},
        "family": {"type": ["string", "null"]},
        "element_id": {"type": ["string", "null"]},
        "accepted": {"type": "boolean"}
      }
    },
    "series": {
      "type": "object", "additionalProperties": false,
      "required": ["series_id", "segment_ids", "state", "gap_ms", "evidence_observation_ids", "confidence_milli"],
      "properties": {
        "series_id": {"type": "string", "minLength": 1},
        "segment_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "state": {"enum": ["continuous", "interrupted", "unresolved"]},
        "gap_ms": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "evidence_observation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "confidence_milli": {"type": "integer", "minimum": 0, "maximum": 1000}
      }
    },
    "artistryDecision": {
      "type": "object", "additionalProperties": false,
      "required": ["decision_id", "criterion_id", "observation_digests", "reviewer_id", "reviewer_qualification_ref", "accepted", "reason_code", "notes", "decided_at", "decision_digest"],
      "properties": {
        "decision_id": {"type": "string", "minLength": 1},
        "criterion_id": {"type": "string", "minLength": 1},
        "observation_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha"}},
        "reviewer_id": {"type": "string", "minLength": 1},
        "reviewer_qualification_ref": {"type": "string", "minLength": 1},
        "accepted": {"type": "boolean"},
        "reason_code": {"type": "string", "minLength": 1},
        "notes": {"type": "string", "minLength": 1},
        "decided_at": {"type": "string", "format": "date-time"},
        "decision_digest": {"$ref": "#/$defs/sha"}
      }
    }
  }
}
