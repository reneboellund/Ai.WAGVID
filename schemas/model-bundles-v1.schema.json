{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai.wagvid.local/schemas/model-bundles-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "components", "profiles"],
  "properties": {
    "schema_version": {"const": "model-bundles-v1"},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "capability", "adapter", "artifact_status", "config_digest"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._@-]+$"},
          "capability": {"enum": ["perception", "action", "interpretation", "quality"]},
          "adapter": {"type": "string", "minLength": 1},
          "artifact_status": {"enum": ["contract-only", "local-available", "validated"]},
          "config_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "checkpoint_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "limitations": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mode", "components", "apparatus"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._@-]+$"},
          "mode": {"enum": ["coaching", "judge-research", "benchmark"]},
          "components": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string"}},
          "apparatus": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["VT", "UB", "BB", "FX", "PH", "SR", "PB", "HB"]}}
        }
      }
    }
  }
}
