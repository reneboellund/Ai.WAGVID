{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/reneboellund/Ai.WAGVID/schemas/performance-report-v1.schema.json",
  "title": "Ai.WAGVID evidence-backed performance report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "report_id", "athlete_group_id", "generated_at", "routine_ids",
    "observed_facts", "patterns", "priorities", "coaching_hypotheses",
    "suggested_training_focuses"
  ],
  "properties": {
    "schema": {"const": "ai.wagvid.performance-report.v1"},
    "report_id": {"type": "string", "minLength": 1},
    "athlete_group_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "routine_ids": {"$ref": "#/$defs/idArray"},
    "observed_facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strengths", "point_loss", "neutral"],
      "properties": {
        "strengths": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
        "point_loss": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
        "neutral": {"type": "array", "items": {"$ref": "#/$defs/observation"}}
      }
    },
    "patterns": {"type": "array", "items": {"$ref": "#/$defs/pattern"}},
    "priorities": {"type": "array", "items": {"$ref": "#/$defs/priority"}},
    "coaching_hypotheses": {"type": "array", "items": {"$ref": "#/$defs/hypothesis"}},
    "suggested_training_focuses": {"type": "array", "items": {"$ref": "#/$defs/trainingFocus"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "idArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "evidence_digest"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "evidence_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id", "athlete_group_id", "routine_id", "event_group_id", "apparatus",
        "category", "pattern_key", "phase", "element_family", "polarity", "description",
        "evidence", "confidence_milli", "review_state", "source_digest", "point_loss_units",
        "semantic_layer"
      ],
      "properties": {
        "observation_id": {"type": "string", "minLength": 1},
        "athlete_group_id": {"type": "string", "minLength": 1},
        "routine_id": {"type": "string", "minLength": 1},
        "event_group_id": {"type": ["string", "null"]},
        "apparatus": {"enum": ["VT", "UB", "BB", "FX"]},
        "category": {"type": "string", "minLength": 1},
        "pattern_key": {"type": "string", "minLength": 1},
        "phase": {"type": ["string", "null"]},
        "element_family": {"type": ["string", "null"]},
        "polarity": {"enum": ["strength", "point-loss", "neutral"]},
        "description": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "confidence_milli": {"type": "integer", "minimum": 0, "maximum": 1000},
        "review_state": {"const": "accepted"},
        "source_digest": {"$ref": "#/$defs/sha256"},
        "point_loss_units": {"type": ["integer", "null"], "minimum": 0},
        "semantic_layer": {"const": "observed-fact"}
      }
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern_id", "athlete_group_id", "apparatus", "pattern_key", "polarity", "category",
        "observation_ids", "routine_ids", "occurrence_count", "routine_count", "evidence_count",
        "point_loss_units", "confidence_floor_milli", "semantic_layer"
      ],
      "properties": {
        "pattern_id": {"type": "string", "minLength": 1},
        "athlete_group_id": {"type": "string", "minLength": 1},
        "apparatus": {"enum": ["VT", "UB", "BB", "FX"]},
        "pattern_key": {"type": "string", "minLength": 1},
        "polarity": {"enum": ["strength", "point-loss", "neutral"]},
        "category": {"type": "string", "minLength": 1},
        "observation_ids": {"$ref": "#/$defs/idArray"},
        "routine_ids": {"$ref": "#/$defs/idArray"},
        "occurrence_count": {"type": "integer", "minimum": 1},
        "routine_count": {"type": "integer", "minimum": 1},
        "evidence_count": {"type": "integer", "minimum": 1},
        "point_loss_units": {"type": ["integer", "null"], "minimum": 0},
        "confidence_floor_milli": {"type": "integer", "minimum": 0, "maximum": 1000},
        "semantic_layer": {"const": "pattern"}
      }
    },
    "dimension": {
      "type": "array",
      "prefixItems": [
        {"type": "string", "minLength": 1},
        {"type": "integer", "minimum": 0}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "priority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priority_number", "pattern_digest", "pattern_key", "dimensions", "coach_id", "coach_rationale"
      ],
      "properties": {
        "priority_number": {"type": "integer", "minimum": 1},
        "pattern_digest": {"$ref": "#/$defs/sha256"},
        "pattern_key": {"type": "string", "minLength": 1},
        "dimensions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dimension"}},
        "coach_id": {"type": "string", "minLength": 1},
        "coach_rationale": {"type": "string", "minLength": 1}
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis_id", "pattern_digest", "text", "created_by", "created_at", "state",
        "coach_review_id", "semantic_layer"
      ],
      "properties": {
        "hypothesis_id": {"type": "string", "minLength": 1},
        "pattern_digest": {"$ref": "#/$defs/sha256"},
        "text": {"type": "string", "minLength": 1},
        "created_by": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "state": {"enum": ["proposed", "coach-confirmed", "coach-rejected"]},
        "coach_review_id": {"type": ["string", "null"]},
        "semantic_layer": {"const": "coaching-hypothesis"}
      }
    },
    "trainingFocus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "focus_id", "pattern_digest", "text", "created_by", "created_at", "state",
        "coach_review_id", "semantic_layer"
      ],
      "properties": {
        "focus_id": {"type": "string", "minLength": 1},
        "pattern_digest": {"$ref": "#/$defs/sha256"},
        "text": {"type": "string", "minLength": 1},
        "created_by": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "state": {"enum": ["suggested", "coach-selected", "coach-rejected"]},
        "coach_review_id": {"type": ["string", "null"]},
        "semantic_layer": {"const": "suggested-training-focus"}
      }
    }
  }
}
