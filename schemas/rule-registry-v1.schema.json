{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/reneboellund/Ai.WAGVID/schemas/rule-registry-v1.schema.json",
  "title": "Ai.WAGVID authoritative rule-source registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_version", "discipline", "cycle", "sources"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "registry_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "discipline": {"const": "WAG"},
    "cycle": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{4}$"},
    "last_checked_at": {"type": "string", "format": "date"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "publisher", "discipline", "cycle", "language", "source_url",
        "publication_date", "effective_from", "status", "interpretation_status",
        "retention", "locators"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "title": {"type": "string", "minLength": 3},
        "publisher": {"const": "World Gymnastics"},
        "discipline": {"const": "WAG"},
        "cycle": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{4}$"},
        "language": {"type": "string", "pattern": "^[a-z]{2}$"},
        "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "publication_date": {"type": "string", "format": "date"},
        "effective_from": {"type": "string", "format": "date"},
        "effective_until": {"type": ["string", "null"], "format": "date"},
        "status": {"enum": ["current", "superseded", "withdrawn", "discovered"]},
        "interpretation_status": {"enum": ["unreviewed", "draft", "reviewed", "approved"]},
        "supersedes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "superseded_by": {"type": ["string", "null"]},
        "retention": {"enum": ["metadata-only", "licensed-copy", "public-copy"]},
        "content_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "notes": {"type": "string"},
        "review": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["reviewer", "reviewed_at"],
          "properties": {
            "reviewer": {"type": "string", "minLength": 1},
            "reviewed_at": {"type": "string", "format": "date"},
            "decision_ref": {"type": "string"}
          }
        },
        "locators": {
          "type": "object",
          "additionalProperties": false,
          "required": ["convention"],
          "properties": {
            "convention": {"enum": ["section", "article", "page", "table", "mixed"]},
            "example": {"type": "string"}
          }
        }
      }
    }
  }
}

