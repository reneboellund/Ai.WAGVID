{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/reneboellund/Ai.WAGVID/schemas/research-baselines-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "last_verified_at", "candidates"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "last_verified_at": {"type": "string", "format": "date"},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "priority", "status", "paper_url", "code_url", "license_status", "artifact_status", "intended_use", "blockers"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "category": {"type": "string", "minLength": 1},
          "priority": {"type": "integer", "minimum": 1, "maximum": 3},
          "status": {"enum": ["approved-for-spike", "evaluate", "research-only", "research-hold", "architecture-reference", "rejected"]},
          "paper_url": {"type": "string", "format": "uri"},
          "code_url": {"type": ["string", "null"], "format": "uri"},
          "license_status": {"type": "string", "minLength": 1},
          "artifact_status": {"type": "string", "minLength": 1},
          "intended_use": {"type": "string", "minLength": 1},
          "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
