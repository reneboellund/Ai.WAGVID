{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai.wagvid.local/schemas/dataset-manifest-v1.schema.json",
  "title": "Ai.WAGVID research dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset", "governance", "split_policy", "samples"],
  "properties": {
    "schema_version": {"const": "dataset-manifest-v1"},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "title", "source_url", "retrieved_at"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
        "version": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "source_url": {"type": "string", "format": "uri"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "citation": {"type": "string"}
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["access_basis", "approved_by", "approved_at", "allowed_uses", "personal_data"],
      "properties": {
        "access_basis": {"type": "string", "minLength": 1},
        "approved_by": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "format": "date-time"},
        "allowed_uses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "personal_data": {"enum": ["none", "pseudonymous", "identifiable"]},
        "restrictions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "split_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["salt", "train", "validation", "test"],
      "properties": {
        "salt": {"type": "string", "minLength": 1},
        "train": {"type": "number", "minimum": 0, "maximum": 1},
        "validation": {"type": "number", "minimum": 0, "maximum": 1},
        "test": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "athlete_group_id", "event_group_id", "routine_group_id", "source_sha256", "media_uri"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "athlete_group_id": {"type": "string"},
          "event_group_id": {"type": "string"},
          "routine_group_id": {"type": "string", "minLength": 1},
          "source_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
          "media_uri": {"type": "string", "minLength": 1},
          "official_score": {
            "type": "object",
            "additionalProperties": false,
            "required": ["total"],
            "properties": {
              "d_score": {"type": "number"},
              "e_score": {"type": "number"},
              "penalty": {"type": "number", "minimum": 0},
              "total": {"type": "number"},
              "source": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
